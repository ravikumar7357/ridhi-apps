{
  "//": "Flowmerce's sync backend — its OWN codebase, so deploying it never touches sellora-live or rone-capture.",
  "functions": [
    {
      "source": ".",
      "codebase": "flowmerce-sync",
      "runtime": "nodejs24",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": ["node_modules", "test", "sql", "src", "*.md", ".git", "firebase-debug.log"]
    }
  ]
}
