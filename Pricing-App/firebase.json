{
  "hosting": {
    "//predeploy": "Since 2026-10-01 the page is built from src/ (module plan step 3): a deploy is refused when public/index.html is not what src/ makes.",
    "predeploy": ["node ../Replenish-App/tests/assemble.js --root . --check"],
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "//": "The page itself is never served from cache without asking first: hostings default max-age=3600 kept a deployed fix invisible for an hour. no-cache still caches — it revalidates, so an unchanged page is a cheap 304.",
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|svg|ico|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "database": {
    "rules": "database.rules.json"
  }
}
