      }
    },
    "pt_vendorOrders": {
      ".write": "auth != null && (auth.token.email.toLowerCase() === 'ravi@thefabricrush.com' || root.child('pt_perms').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) && !root.child('pt_vendorByEmail').child(auth.token.email.replace('.', ',')).exists()",
      "$code": {
        ".read": "auth != null && root.child('pt_vendorByEmail').child(auth.token.email.replace('.', ',')).child('code').val() === $code",
        ".write": "auth != null && root.child('pt_vendorByEmail').child(auth.token.email.replace('.', ',')).child('code').val() === $code"
      }
    },
    "pt_baseData": {
      ".write": "auth != null && (auth.token.email.toLowerCase() === 'ravi@thefabricrush.com' || root.child('pt_perms').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) && !root.child('pt_vendorByEmail').child(auth.token.email.replace('.', ',')).exists()",
