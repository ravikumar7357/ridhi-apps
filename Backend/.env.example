# Copy this file to .env (same folder) and fill in the values. .env is never committed.
# Values are the same as in Google Secret Manager / Pricing-API Script Properties. "none" = not used.
# Only SUPABASE_SERVICE_KEY is needed to start; the heartbeat needs nothing else.

SUPABASE_SERVICE_KEY=
API_KEY=

SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_REFRESH_TOKEN=
CPC_CLIENT_ID=
CPC_CLIENT_SECRET=
CPC_REFRESH_TOKEN=

SP_ADS_CLIENT_ID=
SP_ADS_CLIENT_SECRET=
SP_ADS_REFRESH_TOKEN=
SP_ADS_PROFILE_ID=none
CPC_ADS_CLIENT_ID=
CPC_ADS_CLIENT_SECRET=
CPC_ADS_REFRESH_TOKEN=
CPC_ADS_PROFILE_ID=none

# Where it listens. 127.0.0.1 = this computer only. On a server, 0.0.0.0.
HOST=127.0.0.1
PORT=8080
# Firebase project whose sign-ins are accepted
FIREBASE_PROJECT_ID=price-research-48ff3
# Tasks run at the same time
QUEUE_CONCURRENCY=2
# "no" = wait for the first timer tick instead of running each timer once at start
RUN_AT_START=yes
