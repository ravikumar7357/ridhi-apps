# ONLY THE CODE. This folder also holds order exports, payroll backups and workbooks that must never
# be committed, so everything is ignored and the code folders are let back in one by one.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Replenish-App/
!/Pricing-App/
!/Pricing-API/
!/Repl-API/
!/Repl-API-CPC/
!/shared/

# Firebase's local deploy cache, and anything installed.
.firebase/
node_modules/
firebase-debug.log

# LIVE DATA the suites read when it is there — employee names, payouts, the master database. It stays
# on this disk beside the tests and never goes into history.
/Replenish-App/tests/pa/
/Replenish-App/tests/mix/
/Replenish-App/tests/*.json
# …and what a run writes out.
/Replenish-App/tests/*.xlsx
/Replenish-App/tests/*.csv

# Office lock files.
~$*

# Built copy of Replenish-App/public (node tests/build-dist.js); never edited by hand
Replenish-App/dist/
!/Backup-Script/
# Lighter local builds (node Replenish-App/tests/build-dist-opt.js [app folder]); for trying out, never deployed
Replenish-App/dist-opt/
Pricing-App/dist-opt/
Replenish-App/src/.last-assembled.sha256
Pricing-App/src/.last-assembled.sha256
Replenish-App/src/deps.json
Pricing-App/src/deps.json

# Data pulled for one-off audits (9 Oct 2026): master database, order book and Amazon exports. Not code.
/Replenish-App/tests/sku-audit/
/Replenish-App/tests/probes/store-beyond.json
/Pricing-App/tests/image-audit/*.csv
